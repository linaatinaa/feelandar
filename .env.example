# ============================================================
# Supabase — Project Settings → API
# ============================================================
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon/public key. Not currently used by the server (the API uses the
# service role key below) but kept here in case you want to wire up
# Supabase client-side features later. Safe to expose publicly.
SUPABASE_ANON_KEY=

# Service role key — SECRET. Used only by the /api serverless functions to
# talk to Postgres with full access (bypasses Row Level Security). Never
# expose this in frontend code or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Telegram Bot — from @BotFather
# ============================================================
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL of the deployed mini app (Vercel production URL), used by the
# bot's /start command to build the web_app button, e.g.
# https://seavy.vercel.app
WEBAPP_URL=https://your-app.vercel.app

# Full public URL of this project's API (usually same host as WEBAPP_URL),
# used by scripts/setWebhook.js to register the Telegram webhook, e.g.
# https://seavy.vercel.app
API_URL=https://your-app.vercel.app

# Optional but recommended: random secret string. When set, it is sent to
# Telegram as `secret_token` on setWebhook and verified on every incoming
# webhook request via the X-Telegram-Bot-Api-Secret-Token header, so random
# POSTs to /api/bot-webhook are rejected. Generate with e.g. `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET=

# ============================================================
# Local dev only
# ============================================================
# Port for `npm run dev:api` (Express server used only for local testing;
# on Vercel the same Express app runs as a serverless function).
PORT=3001
